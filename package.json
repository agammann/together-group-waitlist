{
  "name": "together-waitlist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flexible group waitlists with local Qwen and customer-approved PayPal sandbox bookings.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:qwen": "node --env-file-if-exists=.env scripts/check-qwen.mjs",
    "check:http": "node scripts/check-http.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12"
  }
}
